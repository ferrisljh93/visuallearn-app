# VisualLearn external MVP — environment reference (NO real values here).
# This is a static site: at runtime these two values live in js/config.js.
# They are listed here as the canonical names for deployment documentation.
#
# The project URL from your Supabase project settings.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
#
# Supabase's PUBLIC anon/publishable key. It is designed to ship in frontend
# code: it grants nothing by itself — Row Level Security (schema.sql) is the
# boundary, so each signed-in user can only access their own rows.
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
#
# NEVER add the service-role key here or anywhere in this repository.
# It bypasses Row Level Security and would expose every user's data.
